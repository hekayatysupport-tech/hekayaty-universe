# Hekayaty World — Frontend Environment Variables
# Copy this to .env.local for local development

# The base URL of your API server.
# For local dev: http://localhost:5000
# For production: set this as a Vercel environment variable
VITE_API_BASE_URL=http://localhost:5000

# Supabase (public / client-safe keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
